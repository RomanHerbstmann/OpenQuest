# ===== Backend (.NET API), see apps/api/README.md =====
# Copy to .env (never commit .env). ASP.NET Core maps "__" to ":" in configuration keys.
# In Development, appsettings.Development.json has only the non-secret values that match docker-compose.yml.
# Secrets are never committed: Jwt__Key is generated per start in Development, and the admin password is generated on first
# start (printed once in the log) unless Admin__Password is set. Alternatively use `dotnet user-secrets` (UserSecretsId: openquest-api).

ConnectionStrings__Default=Host=localhost;Port=5432;Database=openquest;Username=openquest;Password=openquest

# JWT signing key: at least 32 characters. Generate e.g. with: openssl rand -base64 48
Jwt__Key=change-me-change-me-change-me-change-me
Jwt__Issuer=openquest
Jwt__Audience=openquest

# Seeded admin account (created on startup if missing)
Admin__Username=admin
Admin__Password=change-me-admin

# Outbox: retries of failed event deliveries (first delay, doubles each attempt) and give-up limit
Outbox__RetryBaseDelayMs=5000
Outbox__MaxAttempts=8

# Optional: also commit the changes file to a public GitHub repository (off while the token is empty)
Publishing__GitHub__Token=
Publishing__GitHub__Owner=
Publishing__GitHub__Repo=
Publishing__GitHub__Branch=main
Publishing__GitHub__Path=data/{source}/changes.geojson

# Password hashing (argon2id) and rate limit for /auth/* per IP and minute
Auth__Argon2MemoryKiB=19456
Auth__Argon2TimeCost=2
Auth__RateLimitPerMinute=10

# Photo and export storage (S3-compatible, MinIO locally)
Storage__ServiceUrl=http://localhost:9000
Storage__AccessKey=openquest
Storage__SecretKey=openquest-secret
Storage__Bucket=openquest-photos

# Defaults for new quests (each quest stores its own values)
Game__GeofenceMeters=30
Game__ClaimTimeoutMinutes=30

# Districts of a city must not overlap; overlaps up to this share of the smaller district are tolerated (rounding at shared borders)
# Gamification__OverlapToleranceRatio=0.001

# Tree cards: the frequency of every genus in a district is recalculated when older than this many hours (or after redrawing the district)
# Gamification__GenusStatsMaxAgeHours=24
# Rarity of cards, see RarityProfile.Default. Unset values keep the default. Shares: a genus with at least this share of a district's trees is abundant / common / scarce, below scarce it is very scarce.
# Gamification__Rarity__AbundantShare=0.05
# Gamification__Rarity__CommonShare=0.01
# Gamification__Rarity__ScarceShare=0.002
# Districts with fewer trees of known genus have no reliable statistics: nothing counts as scarce there
# Gamification__Rarity__MinSample=30
# Classes a genus moves towards scarce for new information / a reported problem
# Gamification__Rarity__NewInformationBoost=1
# Gamification__Rarity__ConditionFactBoost=1
# Chances per frequency class (Abundant, Common, Scarce, VeryScarce): common, uncommon, rare, legendary, adding up to 1
# Gamification__Rarity__Weights__VeryScarce__0=0.10
# Gamification__Rarity__Weights__VeryScarce__1=0.30
# Gamification__Rarity__Weights__VeryScarce__2=0.40
# Gamification__Rarity__Weights__VeryScarce__3=0.20

# Levels: points at which each level starts (ascending, first 0). Unset = 0, 100, 250, 500, 800
# Gamification__LevelThresholds__0=0
# Gamification__LevelThresholds__1=100

# Comma-separated list of allowed frontend origins. The phone app (Capacitor) runs its web view under
# https://localhost (Android) and capacitor://localhost (iOS), see apps/api/README.md, "Phone app"
Cors__Origins=http://localhost:3000,http://localhost:5173,https://localhost,capacitor://localhost

# ===== Player app (Next.js in src/) =====
# API behind the same origin proxy /backend/... (next.config.ts). Read at build time, default is production.
# OPENQUEST_API_URL=http://localhost:5076

# ===== Tree photo verification (TypeScript package packages/tree-verification) =====
# OpenRouter key, used for the vision models and for Jev (TypeSafe) via OpenRouter.
OPENROUTER_API_KEY=

# Optional overrides (comma separated model ids).
# VISION_MODELS=google/gemini-3.8-flash,google/gemini-3.5-flash-lite
# VISION_ESCALATION_MODEL=openai/gpt-6-luna
# JEV_MODEL=typesafe/jev-1.13
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# ===== Importer (Python, apps/importer), see apps/importer/README.md =====
# Database the importer writes to (same PostGIS as the API, see docker-compose.yml)
DATABASE_URL=postgresql://openquest:openquest@localhost:5432/openquest

# Optional: server used by the importer's database tests.
# The tests create and drop their own temporary database on this server.
OPENQUEST_TEST_DATABASE_URL=postgresql://openquest:openquest@localhost:5432/postgres
